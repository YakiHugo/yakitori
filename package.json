{
  "name": "yakitori",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:(gui|server)$/\"",
    "dev:gui": "vite --host 127.0.0.1 --strictPort",
    "dev:server": "node src/server/start.ts",
    "build": "pnpm build:gui",
    "build:gui": "vite build",
    "build:desktop": "vite build --mode desktop && node scripts/verify-desktop-prompts.ts",
    "start:desktop": "pnpm build:gui && pnpm build:desktop && electron .",
    "dev:desktop": "pnpm build:desktop && pnpm run --parallel \"/^dev:desktop:(gui|shell)$/\"",
    "dev:desktop:gui": "vite --host 127.0.0.1 --strictPort",
    "dev:desktop:shell": "YAKITORI_STORE_DIR=.yakitori-desktop ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "package:desktop": "pnpm build:gui && pnpm build:desktop && node scripts/package-desktop-runtime.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@electron/rebuild": "4.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fs-ext": "^2.1.1",
    "lucide-react": "^1.27.0",
    "node-pty": "1.2.0-beta.15",
    "openai": "^6.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  }
}
