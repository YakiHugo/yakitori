# Copy to .env (gitignored) and fill in what you use.
# Real environment variables always override this file.

# Provider selection: faux | openai | anthropic | grok | kimi
YAKITORI_PROVIDER=faux
# Required for every network provider.
# YAKITORI_MODEL=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# xAI key; without it, grok falls back to the Grok CLI OAuth login.
# XAI_API_KEY=
# Official Kimi Code console key (sk-kimi-…).
# KIMI_API_KEY=
# Optional Exa key for web_search; without it, the anonymous free tier applies.
# EXA_API_KEY=

# Optional paths.
# YAKITORI_WORKSPACE=
# YAKITORI_STORE_DIR=

# Optional full-agent engines, separate from the model provider above.
# Use an already-installed ACP v1 stdio executable and its documented arguments.
# Engine IDs identify saved sessions; keep an ID stable when changing its label.
# No agent installation or login is performed by Yakitori.
# YAKITORI_ACP_ENGINES=[{"id":"external-agent","label":"External agent","command":"/absolute/path/to/acp-agent","args":[]}]
