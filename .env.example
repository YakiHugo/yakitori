# Copy to .env (gitignored) and fill in what you use.
# Real environment variables always override this file.

# Provider selection: faux | openai | anthropic | grok | kimi
YAKITORI_PROVIDER=faux
# Required for every network provider.
# YAKITORI_MODEL=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# xAI key; without it, grok falls back to the Grok CLI OAuth login.
# XAI_API_KEY=
# Official Kimi Code console key (sk-kimi-…).
# KIMI_API_KEY=

# Optional paths.
# YAKITORI_WORKSPACE=
# YAKITORI_STORE_DIR=
